# Build from the repository root:
# docker build -f Dockerfile.dashboard -t kyounghwan/tuya-power-dashboard:latest .
FROM python:3.13-slim

WORKDIR /app
COPY dashboard/app.py /app/app.py
COPY dashboard/static /app/static

ENV PROMETHEUS_URL=http://127.0.0.1:9090 \
    PORT=8088 \
    CACHE_TTL_SECONDS=5 \
    MAX_HISTORY_HOURS=168

EXPOSE 8088
USER 65532:65532
CMD ["python", "/app/app.py"]
